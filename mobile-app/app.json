{
  "expo": {
    "name": "Proxi",
    "slug": "proxi",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      "expo-font"
    ],
    "android": {
      "package": "com.proxi.attendance",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "versionCode": 5
    },
    "ios": {
      "bundleIdentifier": "com.proxi.attendance",
      "supportsTablet": false,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Allow $(PRODUCT_NAME) to use Bluetooth for attendance check-in.",
        "NSBluetoothPeripheralUsageDescription": "Allow $(PRODUCT_NAME) to advertise attendance sessions."
      }
    },
    "extra": {
      "eas": {
        "projectId": "a34d6fdd-62c8-4827-8b38-32ce213528c4"
      }
    },
    "owner": "isaacayomi"
  }
}
