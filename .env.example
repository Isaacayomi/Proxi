# ====================================================================
# Proxi Web Application - Environment Variables
# Copy this file to .env.local: cp .env.example .env.local
# ====================================================================

# 1. Supabase Project URL (Public)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anonymous Public Key (Public)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> "anon" "public"
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Supabase Service Role Secret Key (Server-side ONLY - Never expose to browser)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> "service_role" "secret"
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 4. Application URL
# http://localhost:3000 for local dev, or your production domain (e.g. https://proxi.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 5. Lecturer & Academic Staff Verification Key
# Departmental key required to register as a lecturer (supports single or comma-separated keys)
LECTURER_VERIFICATION_CODE=OAU-FACULTY-2026


