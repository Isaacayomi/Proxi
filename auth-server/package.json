{
	"name": "proxi-api",
	"scripts": {
		"test": "node tests/auth.test.cjs",
		"lint": "biome check .",
		"test:ui": "vitest --ui",
		"prepare": "npx simple-git-hooks",
		"format": "biome format . --write",
		"dev": "wrangler dev src/index.ts",
		"db:migrate": "wrangler d1 migrations apply neuron-db --local",
		"db:generate": "drizzle-kit generate",
		"lint:fix": "pnpm lint --write --unsafe",
		"deploy": "wrangler deploy --minify src/index.ts",
		"test:legacy": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@9.6.0",
	"dependencies": {
		"@hono/valibot-validator": "^0.3.0",
		"drizzle-orm": "^0.32.0",
		"hono": "^4.5.1",
		"nanoid": "^5.0.7",
		"picocolors": "^1.0.1",
		"pino": "^9.3.1",
		"valibot": "^0.37.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.8.3",
		"@cloudflare/vitest-pool-workers": "^0.4.23",
		"@cloudflare/workers-types": "^4.20240529.0",
		"@vitest/ui": "^2.0.5",
		"drizzle-kit": "^0.23.1",
		"lint-staged": "^15.2.7",
		"simple-git-hooks": "^2.11.1",
		"typescript": "^5.5.3",
		"vitest": "1.5.0",
		"wrangler": "^4.152.0"
	},
	"lint-staged": {
		"*.ts": [
			"biome format --no-errors-on-unmatched --write",
			"biome check --no-errors-on-unmatched"
		],
		"!(*.ts)": [
			"biome format --no-errors-on-unmatched --write"
		]
	},
	"simple-git-hooks": {
		"pre-commit": "npx lint-staged"
	}
}
